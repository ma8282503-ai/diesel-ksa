            if (currentLang === 'en') {
                body.setAttribute('dir', 'ltr');
                body.classList.add('lang-en');
                langBtnText.innerText = 'عربي';
            } else {
                body.setAttribute('dir', 'rtl');
                body.classList.remove('lang-en');
                langBtnText.innerText = 'English';
            }

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (i18n[currentLang][key]) {
                    el.innerText = i18n[currentLang][key];
                }
            });

            calculateDiesel();
        }

        function calculateDiesel() {
            const qty = parseInt(document.getElementById('dieselQty').value) || 0;
            const truckEl = document.getElementById('truckType');
            const timeEl = document.getElementById('deliveryTime');

            if (qty < 5000) {
                truckEl.innerText = currentLang === 'ar' ? 'صهريج صغير (دینا)' : 'Small Tanker Truck';
                timeEl.innerText = currentLang === 'ar' ? 'خلال 1 - 2 ساعة' : 'Within 1 - 2 Hours';
            } else if (qty <= 18000) {
                truckEl.innerText = currentLang === 'ar' ? 'صهريج متوسط (سكس)' : 'Medium Tanker Truck';
                timeEl.innerText = currentLang === 'ar' ? 'خلال 2 - 4 ساعات' : 'Within 2 - 4 Hours';
            } else {
                truckEl.innerText = currentLang === 'ar' ? 'صهريج كبير (تريلا)' : 'Heavy Trailer Tanker';
                timeEl.innerText = currentLang === 'ar' ? 'توصيل فوري / مجدول' : 'Instant / Scheduled';
            }
        }

        function sendCalculatedOrder() {
            const qty = document.getElementById('dieselQty').value;
            const msg = `السلام عليكم، أرغب في طلب توريد ديزل بكمية: ${qty} لتر. أرجو تزويدي بالسعر وتأكيد الموعد.`;
            window.open(`https://wa.me/966579309690?text=${encodeURIComponent(msg)}`, '_blank');
        }
    </script>
</body>
</html>
